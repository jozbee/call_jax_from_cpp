# Doxygen configuration for the C++ headers: XML only, which Breathe reads.
# Run from docs/, as conf.py does; INPUT and OUTPUT_DIRECTORY are relative to
# it.

PROJECT_NAME           = pjrt_exec
PROJECT_BRIEF          = "Load once, call many: JAX executables from C++"

OUTPUT_DIRECTORY       = _build/doxygen
INPUT                  = ../include/pjrt_exec ../examples/common
FILE_PATTERNS          = *.hpp
RECURSIVE              = NO

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES

# The source listing is never rendered: Sphinx links to GitHub for source.
XML_PROGRAMLISTING     = NO

# Load-bearing: an undocumented member is absent from the XML, so the directive
# that names it fails the Sphinx build rather than rendering an empty box.
EXTRACT_ALL            = NO
HIDE_UNDOC_MEMBERS     = YES

# The examples' internals: not part of the reference, and Breathe would raise
# a duplicate declaration for each one it saw twice.
EXCLUDE_SYMBOLS        = cjfc::detail cjfc::detail::* \
                         cjfc::workload::detail cjfc::workload::detail::*

# Breathe is the gate for the public API; a warning per private helper would
# drown it out.
WARN_IF_UNDOCUMENTED   = NO

JAVADOC_AUTOBRIEF      = YES
BUILTIN_STL_SUPPORT    = YES

# The reference documents the Linux behaviour. __unix__ is for alloc_guard.hpp:
# without it Doxygen takes the inert stand-in branch and documents a class
# whose every accessor returns 0.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = __linux__=1 \
                         __unix__=1 \
                         PJRT_ALLOC_GUARD_SUPPORTED=1

QUIET                  = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
