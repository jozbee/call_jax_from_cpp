# Build trees
build/
docs/_build/
*.o
*.d
*.a
*.so
*.dylib

# Exported artifacts. Serialized executables embed target machine code, so they
# are locked to the machine that exported them and must never be committed:
# re-export with `make export` wherever you are running.
artifacts/
*.binpb
*.mlirbc

