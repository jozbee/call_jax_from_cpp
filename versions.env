# The single source of truth for every version this project pins. Read by the
# Makefile, CMake, the docs build and CI; never hand-type a version elsewhere.

# The JAX release this tree is pinned to; jaxlib must match exactly. Not the
# latest on purpose: jax-ml/jax#40101 (0.11.1 onward) is an XLA:CPU codegen
# regression that makes a dynamic-update-slice in a loop body cost
# O(buffer x trip count). It is an export-time defect, so no plugin-side patch
# can substitute. docs/developer/open-threads.md says what to measure first.
JAX_VERSION=0.11.0
JAXLIB_VERSION=0.11.0

# The openxla/xla commit JAX pins at that release: third_party/xla/revision.bzl
# at the jax-v<JAX_VERSION> tag.
XLA_COMMIT=131bf41acb4650e4391a640c3f1859c1c86ad74b

# Our fork of XLA: XLA_COMMIT plus the patches in third_party/patches/, which
# docs/developer/xla-fork.md describes. XLA_FORK_COMMIT must name a PUSHED
# commit: a local-only one cannot be fetched by anyone, its author included.
XLA_FORK_REPO=https://github.com/jozbee/xla.git
XLA_FORK_BRANCH=cjfc/jax-v0.11.0
XLA_FORK_COMMIT=d367671377d0392c2f32b78be25c9129033207f0

# PJRT C API version of the headers vendored in third_party/pjrt/.
PJRT_API_MAJOR=0
PJRT_API_MINOR=114

# GitHub release tag holding the prebuilt CPU plugin for this JAX version.
PLUGIN_RELEASE=plugin-jax-v0.11.0
