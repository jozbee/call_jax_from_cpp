# The single source of truth for every version this project pins.
# Read by the Makefile, CMake, the docs build and CI. Never hand-type a
# version anywhere else.

# The JAX release this tree is pinned to. jaxlib must match exactly.
JAX_VERSION=0.11.1
JAXLIB_VERSION=0.11.1

# The openxla/xla commit that JAX pins at that release
# (jax-ml/jax @ jax-v0.11.1 : third_party/xla/revision.bzl).
XLA_COMMIT=dcf304bc5dca1932b99f740b911dbd73631a1a69

# Our fork of XLA, which carries three commits on top of XLA_COMMIT:
#   1. jaxlib's LAPACK FFI kernels linked into the CPU plugin
#   2. those kernels re-vendored from the pinned JAX release
#   3. CPU plugin create options + the plugin attributes that advertise them
# They are also kept as third_party/patches/*.patch so the fork can be
# rebuilt from this repository alone. XLA_FORK_COMMIT must name a commit that
# has been PUSHED: a previous patch was referenced here without being pushed
# and could not be fetched by anyone. See docs/developer/xla-fork.md.
XLA_FORK_REPO=https://github.com/jozbee/xla.git
XLA_FORK_BRANCH=cjfc/jax-v0.11.1
XLA_FORK_COMMIT=70c8022380970734e4a67934116eb2f0f8d0839a

# PJRT C API version of the headers vendored in third_party/pjrt/.
PJRT_API_MAJOR=0
PJRT_API_MINOR=114

# GitHub release tag holding the prebuilt CPU plugin for this JAX version.
PLUGIN_RELEASE=plugin-jax-v0.11.1
