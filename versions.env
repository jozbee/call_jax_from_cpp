# The single source of truth for every version this project pins.
# Read by the Makefile, CMake, the docs build and CI. Never hand-type a
# version anywhere else.

# The JAX release this tree is pinned to. jaxlib must match exactly.
#
# This is deliberately NOT the latest release. jax-ml/jax#40101 is an XLA:CPU
# codegen regression, present from 0.11.1 onward, that makes a
# dynamic-update-slice inside a loop body cost O(buffer x trip count) rather
# than O(update x trip count). It is an export-time defect -- jaxlib compiles
# the machine code the artifact embeds -- so pinning jaxlib is the fix, and no
# plugin-side patch can substitute for it. Before moving this forward, check
# the issue and measure: docs/developer/open-threads.md says what to run.
JAX_VERSION=0.11.0
JAXLIB_VERSION=0.11.0

# The openxla/xla commit that JAX pins at that release
# (jax-ml/jax @ jax-v0.11.0 : third_party/xla/revision.bzl).
XLA_COMMIT=131bf41acb4650e4391a640c3f1859c1c86ad74b

# Our fork of XLA, which carries three commits on top of XLA_COMMIT:
#   1. jaxlib's LAPACK FFI kernels linked into the CPU plugin
#   2. those kernels re-vendored -- from jax-v0.11.1 rather than from the
#      pinned release, deliberately; only lapack_kernels.cc differs between
#      the two and docs/developer/xla-fork.md says why the newer copy is kept
#   3. CPU plugin create options + the plugin attributes that advertise them
# They are also kept as third_party/patches/*.patch so the fork can be
# rebuilt from this repository alone. XLA_FORK_COMMIT must name a commit that
# has been PUSHED: a previous patch was referenced here without being pushed
# and could not be fetched by anyone. See docs/developer/xla-fork.md.
XLA_FORK_REPO=https://github.com/jozbee/xla.git
XLA_FORK_BRANCH=cjfc/jax-v0.11.0
XLA_FORK_COMMIT=d367671377d0392c2f32b78be25c9129033207f0

# PJRT C API version of the headers vendored in third_party/pjrt/.
# Unchanged by the 0.11.1 -> 0.11.0 move: pjrt_c_api.h is byte-identical
# between the two XLA revisions.
PJRT_API_MAJOR=0
PJRT_API_MINOR=114

# GitHub release tag holding the prebuilt CPU plugin for this JAX version.
PLUGIN_RELEASE=plugin-jax-v0.11.0
