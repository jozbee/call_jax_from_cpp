{
  "name": "call_jax_from_cpp",
  // Through docker/compose.yml so a VS Code session gets the real-time
  // privileges `docker compose run dev` gets (CAP_SYS_NICE, rtprio, memlock);
  // a plain devcontainer build has none, and every rt helper reports [skip].
  "dockerComposeFile": ["../docker/compose.yml"],
  "service": "dev",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.makefile-tools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
