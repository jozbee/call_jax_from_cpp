{
  "name": "call_jax_from_cpp",
  // Goes through docker/compose.yml rather than building the Dockerfile
  // directly, so a VS Code session gets the same real-time privileges as
  // `docker compose run dev`: SCHED_FIFO needs CAP_SYS_NICE plus an rtprio
  // limit, and mlockall needs an unlimited memlock. A plain devcontainer build
  // has neither, and every rt helper then reports [skip].
  "dockerComposeFile": ["../docker/compose.yml"],
  "service": "dev",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.makefile-tools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
